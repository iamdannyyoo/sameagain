{
  "name": "sameagain",
  "version": "0.0.2",
  "description": "Set up repositories with my preferred configuration",
  "type": "module",
  "bin": {
    "sameagain": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepare": "npm run build",
    "release:patch": "npm test && npm version patch && npm publish && git push origin HEAD --follow-tags"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iamdannyyoo/sameagain.git"
  },
  "license": "ISC",
  "packageManager": "pnpm@10.30.1",
  "devDependencies": {
    "@types/node": "22.19.9",
    "typescript": "5.9.3"
  }
}
